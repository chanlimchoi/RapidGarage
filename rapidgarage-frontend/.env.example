# Copy to .env (never commit .env). Read by Vite at dev/build time.
# Optional fallback browser key for Google Maps, used only when the backend
# offers no key (no per-user key and no server GOOGLE_MAPS_API_KEY).
# Enable "Maps JavaScript API" and "Geocoding API", and restrict it by HTTP
# referrer (e.g. http://localhost:3000/*, your prod domain).
# Only VITE_* variables reach the browser bundle. The legacy name
# GOOGLE_MAPS_API_KEY is still accepted here as a fallback.
VITE_GOOGLE_MAPS_API_KEY=
