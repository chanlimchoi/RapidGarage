# RapidGarage production settings. Copy to .env.production (never commit it):
#   cp .env.production.example .env.production && chmod 600 .env.production
# docker compose reads it for both the containers and ${...} substitution:
#   docker compose --env-file .env.production up -d --build
# On Render/Fly, enter the same names as environment variables / secrets.
# See DEPLOY.md. Generate secrets with: openssl rand -hex 32

# ============================ REQUIRED =====================================
NODE_ENV=production
# Public address people (and printed QR codes) use. https in production.
# For a local docker compose test: http://localhost:8080
APP_BASE_URL=https://sales.example.com
# Long random string (>= 32 chars). Signs session cookies. Changing it logs
# everyone out.
SESSION_SECRET=
# Postgres connection. docker compose builds it from POSTGRES_PASSWORD below;
# on Render/Fly paste the URL the provider gives you.
DATABASE_URL=
# TLS to Postgres: off (private network, compose, Fly internal), verify, or
# no-verify (encrypted, certificate not checked; some managed hosts need it).
DATABASE_SSL=off
# DATABASE_SSL_CA=   # PEM for DATABASE_SSL=verify with a private CA ("\n" ok)

# --- docker compose only (bundled Postgres) --------------------------------
# Use hex (openssl rand -hex 24) so it needs no URL-escaping.
POSTGRES_PASSWORD=
# Host port the app is published on (127.0.0.1 only; put Caddy/nginx in front).
APP_PORT=8080
# With the "https" profile: the domain Caddy gets a certificate for (its DNS
# A/AAAA record must point at this server, ports 80 and 443 open).
DOMAIN=sales.example.com

# ======================= PROXY, COOKIES, HEADERS ==========================
# Number of reverse proxies in front of the app (Render, Fly, Caddy: 1).
# "false" when the app is reached directly (nothing in front). Wrong values
# break secure cookies (too few) or let clients fake their IP (too many).
TRUST_PROXY=1
# Session cookie Secure flag: true | false | auto. Default: true when
# APP_BASE_URL is https, otherwise auto (Secure only on HTTPS requests).
# COOKIE_SECURE=
# Strict-Transport-Security. Default: on when APP_BASE_URL is https.
# HSTS=
# DEBUG_PROXY=false     # true: GET /healthz/proxy echoes your IP/https as the app
#                       # sees them; use once to check TRUST_PROXY, then turn off
# CSP_REPORT_ONLY=false   # true: report CSP violations in the console, don't block
# SECURITY_HEADERS_OFF=false
# Allowed browser origin for API calls with cookies. Single-process deploys
# default it to APP_BASE_URL's origin; set only if the frontend lives elsewhere.
# FRONTEND_ORIGIN=

# ========================= ABUSE / DDOS LIMITS =============================
# Per client IP, per process (DEPLOY.md, "Abuse and DDoS protection").
# RATE_LIMIT=on
# RATE_LIMIT_API_PER_MINUTE=300
# RATE_LIMIT_WRITES_PER_MINUTE=60
# RATE_LIMIT_AUTH_PER_15_MINUTES=30     # login, signup, password reset
# LOGIN_MAX_FAILURES=5                  # per email + IP, 15 minutes
# LOGIN_MAX_FAILURES_PER_EMAIL=50       # per email from anywhere, 15 minutes
# MAX_CONCURRENT_REQUESTS=500           # beyond this: 503 at once
# HTTP_HEADERS_TIMEOUT_MS=15000
# HTTP_REQUEST_TIMEOUT_MS=120000
# ALL_POSTS_MAX=500
# PORT=8080              # the image listens on 8080
# The Docker image sets this; it makes the app serve the built frontend.
# SERVE_FRONTEND_DIR=/app/frontend

# ============================== DATABASE ==================================
# RUN_MIGRATIONS=true     # Docker entrypoint runs `npm run release` first.
#                         # Set false when the host runs it (Fly/Render).
# RELEASE_DB_WAIT_SECONDS=60
# READYZ_CHECK_MIGRATIONS=true  # /readyz fails while migrations are pending
# DB_POOL_MAX=10
# DB_LOG_SQL=false
# SESSION_STORE=postgres
# SESSION_MAX_AGE_DAYS=14
# SESSION_PRUNE_INTERVAL_MINUTES=15

# ============================= GOOGLE MAPS ================================
# Browser key for the map (HTTP-referrer restricted to APP_BASE_URL/*).
GOOGLE_MAPS_API_KEY=
# Server key for geocoding addresses (Geocoding API, IP-restricted or
# unrestricted; NOT the referrer-restricted browser key).
GOOGLE_GEOCODING_API_KEY=
# Optional: lets people search nearby public places (Google Places API "Text
# Search (New)") when suggesting a meetup spot in a conversation. Server-side
# only; restrict it to the Places API. Without it, the admin-curated "Safe
# meetup spots" list (Admin -> Meetup spots) and typed-in places still work.
# GOOGLE_PLACES_API_KEY=
# Encrypts users' own saved Maps keys. Required if ENABLE_USER_MAPS_KEYS.
# Changing it makes saved keys unreadable.
KEY_ENCRYPTION_SECRET=
ENABLE_USER_MAPS_KEYS=true
# GEOCODE_MAX_PER_SECOND=10
# GEOCODE_SEARCH_PER_MINUTE=20

# ======================== SIGN IN WITH GOOGLE (optional) ==================
# Authorized redirect URI in Google Cloud Console must equal this exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://sales.example.com/api/auth/google/callback

# ================================ ADMINS ==================================
# Verified Google accounts with these emails become admins on sign-in.
ADMIN_EMAILS=
# Also promote them on email/password signup (unverified!): only right after
# deploying, then set back to false.
ADMIN_BOOTSTRAP_LOCAL=false

# ============================ EMAIL (SMTP) ================================
# Without SMTP_HOST the app works but sale-alert emails are logged and skipped,
# and "Forgot password?" explains that reset emails aren't available.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RapidGarage <alerts@sales.example.com>"
# SMTP_SECURE=false      # default: true only on port 465
# ALERT_TOKEN_SECRET=    # signs unsubscribe links (default SESSION_SECRET)
# PASSWORD_RESET_TTL_MINUTES=60
# PASSWORD_RESET_MAX_PER_HOUR=3        # emails per account
# PASSWORD_RESET_MAX_PER_IP_HOUR=20
# ENABLE_SALE_ALERTS=true
# ALERT_WORKER=on        # off: don't send alerts from this process
# ALERTS_MAX_PER_USER=5
# ALERT_DIGEST_MINUTES=15
# ALERT_DAILY_MAX_EMAILS=6
# ALERT_MAX_POSTS_PER_EMAIL=20
# ALERT_WORKER_SECONDS=60
# ===================== DRAFT ITEMS FROM PHOTOS (CLAUDE) ======================
# Sellers can have Claude suggest items and prices from their sale photos.
# Off unless ANTHROPIC_API_KEY is set; every draft is billed to this key.
# ANTHROPIC_API_KEY=
# ENABLE_AI_ITEMS=true          # initial default for the admin switch
# AI_ITEMS_PER_DAY=10           # drafts per seller per 24 h (per process)
# AI_ITEMS_MODEL=claude-opus-5-5
# AI_ITEMS_EFFORT=medium        # low | medium | high | xhigh | max
# AI_ITEMS_TIMEOUT_MS=90000
# FOLLOWS_MAX_PER_USER=500   # people one account can follow; new-sale emails share the alert budget
# Wanted posts ("looking for ..."): matches share the alert worker, SMTP,
# digest interval and daily email cap above. Admins can also turn it off.
# ENABLE_WANTED_POSTS=true
# WANTED_MAX_ACTIVE=10    # active wanted posts per user
# WANTED_MAX_PER_DAY=20   # new wanted posts per user per 24 hours
# Morning-of reminders for saved sales run in the same worker tick (ALERT_WORKER);
# safe with several instances (unique per user+sale+day, claimed rows). Without
# SMTP the email is logged and skipped; the in-app notice still shows.
# REMINDER_HOUR=7          # local hour in the sale's time zone (0-12); an hour before earlier sales
# REMINDER_LATE_HOURS=3    # how long after that a reminder may still go out (1-12)
# Link previews (Open Graph / Twitter cards for shared sale, neighborhood-sale and
# wanted links) are built from APP_BASE_URL, which must be the public https URL.
# Preview images (1200x630) are cached on disk; any writable directory works and
# it can be wiped at any time (default: the OS temp dir).
# SHARE_CACHE_DIR=/data/share-cache

# ============================ PHOTOS / UPLOADS ============================
# Only local disk storage exists (lib/storage); the image uses the
# /data/uploads volume. Keep ONE app instance unless that disk is shared.
UPLOAD_DIR=/data/uploads
PHOTO_STORAGE=local
# PHOTO_PUBLIC_BASE=/api/uploads

# =========================== LIMITS & MODERATION ==========================
# DEFAULT_TIME_ZONE=America/New_York
# REPORT_MAX_PER_HOUR=10
# REPORT_AUTO_HIDE_THRESHOLD=
# MESSAGE_MAX_PER_MINUTE=20
# CONVERSATION_MAX_PER_HOUR=20
# Item holds: hours a request waits for the seller, default hold length,
# open holds per buyer, hold requests per buyer per 24 h.
# HOLD_REQUEST_HOURS=24
# HOLD_HOURS=24
# HOLD_MAX_ACTIVE=5
# HOLD_MAX_PER_DAY=10
# Neighborhood sales: upcoming events per organizer, events created per
# organizer per 24 h, sales (pending + approved) per event.
# EVENT_MAX_ACTIVE=3
# EVENT_MAX_PER_DAY=5
# EVENT_MAX_SALES=200
# Free on the curb: "Taken" taps per signed-in user per hour (sellers exempt).
# CURBSIDE_TAKEN_PER_HOUR=10

# ================================ BACKUPS =================================
# docker compose "backup" service (scripts/backup-db.sh --loop).
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14
