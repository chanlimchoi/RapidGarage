# DISABLED: GitHub Actions is unavailable because the account is locked for billing.
# Every job is refused before it starts ("The job was not started because your account is locked due to a billing issue.").
# Rename this file back to ci.yml after fixing billing to re-enable CI.

# Tests, builds and checks for every pull request and every push to master.
# Linux runners also cover the tests that only pass on POSIX systems
# (backup-db.sh) and the Postgres-only behaviour SQLite can't show.
name: CI

on:
  pull_request:
  push:
    branches: [master]

permissions:
  contents: read

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  backend-sqlite:
    name: Backend tests (SQLite, Node ${{ matrix.node }})
    runs-on: ubuntu-latest
    timeout-minutes: 20
    strategy:
      fail-fast: false
      matrix:
        node: [22, 24]
    defaults:
      run:
        working-directory: rapidgarage-backend
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: ${{ matrix.node }}
          cache: npm
          cache-dependency-path: rapidgarage-backend/package-lock.json
      - run: npm ci --no-audit --no-fund
      - run: npm test

  backend-postgres:
    name: Backend tests + migrations (Postgres 17)
    runs-on: ubuntu-latest
    timeout-minutes: 25
    services:
      postgres:
        image: postgres:17
        env:
          POSTGRES_USER: rg
          POSTGRES_PASSWORD: rg
          POSTGRES_DB: rapidgarage_test
        ports: ['5432:5432']
        options: >-
          --health-cmd "pg_isready -U rg"
          --health-interval 5s
          --health-timeout 5s
          --health-retries 10
    defaults:
      run:
        working-directory: rapidgarage-backend
    env:
      PGPASSWORD: rg
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 24
          cache: npm
          cache-dependency-path: rapidgarage-backend/package-lock.json
      - run: npm ci --no-audit --no-fund
      # Every migration must apply cleanly to an empty database (and undo).
      - name: Migrations on a fresh database
        env:
          NODE_ENV: test
          TEST_DATABASE_URL: postgres://rg:rg@localhost:5432/rapidgarage_migrate_test
        run: |
          createdb -h localhost -U rg rapidgarage_migrate_test
          npx sequelize-cli db:migrate
          npx sequelize-cli db:migrate:undo:all
          npx sequelize-cli db:migrate
      - name: Test suite on Postgres
        env:
          TEST_DATABASE_URL: postgres://rg:rg@localhost:5432/rapidgarage_test
          RG_ALLOW_TEST_PG: '1'
        run: npm test

  frontend:
    name: Frontend tests + build
    runs-on: ubuntu-latest
    timeout-minutes: 15
    defaults:
      run:
        working-directory: rapidgarage-frontend
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 24
          cache: npm
          cache-dependency-path: rapidgarage-frontend/package-lock.json
      - run: npm ci --no-audit --no-fund
      - run: npm test
      - run: npm run build
      - run: npm run check:pwa

  docker:
    name: Docker image builds
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4
      - uses: docker/setup-buildx-action@v3
      - uses: docker/build-push-action@v6
        with:
          context: .
          push: false
          cache-from: type=gha
          cache-to: type=gha,mode=max

  # Known advisories in production dependencies. Informational until the
  # dependency upgrades land; then remove continue-on-error to make it blocking.
  audit:
    name: Dependency audit (production)
    runs-on: ubuntu-latest
    timeout-minutes: 10
    continue-on-error: true
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 24
      - name: Backend
        working-directory: rapidgarage-backend
        run: npm audit --omit=dev --audit-level=high
      - name: Frontend
        if: always()
        working-directory: rapidgarage-frontend
        run: npm audit --omit=dev --audit-level=high
