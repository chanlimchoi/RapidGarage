# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://rg_user:CHANGE_ME@127.0.0.1:5432/rapid_garage_development
SESSION_SECRET=CHANGE_ME_long_random_string
# Origin allowed to call the API with cookies (the frontend dev server by default)
FRONTEND_ORIGIN=http://localhost:3000
PORT=8000
NODE_ENV=development

# --- Sign in with Google (optional) ---------------------------------------
# Create an OAuth 2.0 Client ID (type "Web application") in Google Cloud Console.
# Authorized redirect URI must exactly match GOOGLE_CALLBACK_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# --- Bring-your-own Google Maps key ----------------------------------------
# Encrypts users' saved Maps keys at rest (AES-256-GCM). Long random string,
# e.g. `openssl rand -base64 32`. Changing it makes saved keys unreadable.
KEY_ENCRYPTION_SECRET=
# Optional server-wide fallback Maps browser key (used when a user has none).
GOOGLE_MAPS_API_KEY=
