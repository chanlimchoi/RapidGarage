# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://rg_user:CHANGE_ME@127.0.0.1:5432/rapid_garage_development
SESSION_SECRET=CHANGE_ME_long_random_string
# Login sessions are stored in Postgres (table "session", created by
# `npm run migrate`), so they survive restarts. Tests use the memory store.
# SESSION_STORE=postgres            # or "memory" (dev only; logs everyone out on restart)
# SESSION_MAX_AGE_DAYS=14           # cookie + stored session lifetime
# SESSION_PRUNE_INTERVAL_MINUTES=15 # how often expired sessions are deleted
# Origin allowed to call the API with cookies (the frontend dev server by default)
FRONTEND_ORIGIN=http://localhost:3000
PORT=8000
NODE_ENV=development

# --- Sign in with Google (optional) ---------------------------------------
# Create an OAuth 2.0 Client ID (type "Web application") in Google Cloud Console.
# Authorized redirect URI must exactly match GOOGLE_CALLBACK_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# --- Bring-your-own Google Maps key ----------------------------------------
# Encrypts users' saved Maps keys at rest (AES-256-GCM). Long random string,
# e.g. `openssl rand -base64 32`. Changing it makes saved keys unreadable.
KEY_ENCRYPTION_SECRET=
# Optional server-wide fallback Maps browser key (used when a user has none).
GOOGLE_MAPS_API_KEY=
# Initial default for "let users save their own Maps key" (default: true).
# Once an admin flips the toggle on the Admin page, the saved setting wins and
# this value is ignored. Saved keys are never deleted when the feature is off.
ENABLE_USER_MAPS_KEYS=true

# --- Admins -----------------------------------------------------------------
# Comma-separated emails promoted to admin when they sign in with a *verified*
# Google account. Admins can then promote/demote others on the Admin page.
ADMIN_EMAILS=
# Also promote listed emails on local email/password signup/login. Local emails
# are NOT verified, so only enable this if nobody else can register that email
# first (e.g. create the admin account yourself right after deploying).
ADMIN_BOOTSTRAP_LOCAL=false

# Post photos (see README "Post photos").
# UPLOAD_DIR=./uploads
# PHOTO_STORAGE=local
# PHOTO_PUBLIC_BASE=/api/uploads

# Map search / server-side geocoding (see README "Map search").
# Key used to geocode post addresses and typed searches on the server. Must be a
# key that allows the Geocoding API from this server (an HTTP-referrer-restricted
# browser key will be rejected). Falls back to GOOGLE_MAPS_API_KEY, then to the
# user's own key when "users can save their own Maps key" is enabled.
GOOGLE_GEOCODING_API_KEY=
# Outgoing geocode calls per second (all users) and typed-search geocodes per
# minute per user/IP. Defaults: 10 and 20.
# GEOCODE_MAX_PER_SECOND=10
# GEOCODE_SEARCH_PER_MINUTE=20
