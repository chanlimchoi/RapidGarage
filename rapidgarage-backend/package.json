{
  "name": "backend-starter-code",
  "version": "1.0.0",
  "description": "Starter code for an Express/Sequelize backend.",
  "main": "app.js",
  "scripts": {
    "start": "nodemon -L app.js",
    "test": "NODE_ENV=test SESSION_SECRET=test-secret mocha --exit test",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "db:precheck": "node scripts/db-precheck.js precheck",
    "db:cleanup": "node scripts/db-precheck.js cleanup",
    "geocode:backfill": "node scripts/geocode-backfill.js"
  },
  "author": "Edgardo Molina",
  "license": "ISC",
  "devDependencies": {
    "mocha": "^10.7.3",
    "sequelize-cli": "^6.6.5",
    "sqlite3": "^5.1.7",
    "supertest": "^7.0.0"
  },
  "dependencies": {
    "bcrypt-nodejs": "0.0.3",
    "body-parser": "^1.18.2",
    "dotenv": "^8.6.0",
    "express": "^4.16.1",
    "express-handlebars": "^3.0.0",
    "express-session": "^1.15.6",
    "multer": "^2.4.0",
    "nodemon": "^1.12.1",
    "passport": "^0.4.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "sharp": "^0.34.5"
  }
}
