{
  "name": "backend-starter-code",
  "version": "1.0.0",
  "description": "Starter code for an Express/Sequelize backend.",
  "main": "app.js",
  "scripts": {
    "start": "nodemon -L app.js",
    "test": "NODE_ENV=test SESSION_SECRET=test-secret mocha test",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "release": "node scripts/release.js",
    "db:precheck": "node scripts/db-precheck.js precheck",
    "db:cleanup": "node scripts/db-precheck.js cleanup",
    "geocode:backfill": "node scripts/geocode-backfill.js",
    "start:prod": "node app.js"
  },
  "author": "Edgardo Molina",
  "license": "ISC",
  "devDependencies": {
    "mocha": "^10.7.3",
    "nodemon": "^3.1.14",
    "sqlite3": "^5.1.7",
    "supertest": "^7.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "bcrypt-nodejs": "0.0.3",
    "body-parser": "^1.20.8",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^8.6.0",
    "express": "^4.22.3",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.7",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "ini": "^1.3.8"
  }
}
